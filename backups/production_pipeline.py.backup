# LAYER 2: HUMAN REVIEW & ACTIVE LEARNING
# ============================================================================

class Layer2_HumanReview:
    """
    Human-in-the-loop for uncertain cases + Active learning
    """
    
    def __init__(self, review_dir: str = None):
        self.review_dir = review_dir or PRODUCTION['review_dir']
        os.makedirs(self.review_dir, exist_ok=True)
        self.review_queue = []
        
    def needs_review(self, layer0_result: Dict, layer1_result: Dict) -> bool:
        """
        Determine if case needs human review
        
        Triggers:
        1. Low confidence (< 70%)
        2. Layer disagreement (Layer 0 says anomaly, Layer 1 says normal)
        3. Model disagreement (specialists disagree significantly)
        """
        # Trigger 1: Low confidence
        if layer1_result['confidence'] < 0.70:
            return True
        
        # Trigger 2: Layer contradiction
        if layer0_result['is_anomaly'] and not layer1_result['is_attack']:
            if layer1_result['confidence'] < 0.90:
                return True
        
        # Trigger 3: Model disagreement
        attack_votes = layer1_result['attack_votes']
        if attack_votes == 1 or attack_votes == 2:  # Split decision
            return True
        
        return False
    
    def add_to_queue(self, sample_data: Dict):
        """Add sample to human review queue"""
        review_item = {
            'id': f"review_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
            'timestamp': datetime.now().isoformat(),
            'data': self._convert_to_json_serializable(sample_data),
            'status': 'pending'
        }
        
        self.review_queue.append(review_item)
        
        # Save to file
        filename = os.path.join(self.review_dir, f"{review_item['id']}.json")
        with open(filename, 'w') as f:
            json.dump(review_item, f, indent=2)
        
        return review_item['id']
    
    def _convert_to_json_serializable(self, obj):
        """Convert NumPy types to native Python types for JSON serialization"""
        if isinstance(obj, dict):
            return {key: self._convert_to_json_serializable(value) for key, value in obj.items()}
        elif isinstance(obj, list):
            return [self._convert_to_json_serializable(item) for item in obj]
        elif isinstance(obj, np.integer):
            return int(obj)
        elif isinstance(obj, np.floating):
            return float(obj)
        elif isinstance(obj, np.ndarray):
            return obj.tolist()
        elif isinstance(obj, (bool, np.bool_)):
            return bool(obj)
        else:
            return obj
    
    def submit_analyst_label(self, sample_id: str, label: str, notes: str = ""):
        """Analyst provides correct label"""
        # Find and update review item
        for item in self.review_queue:
            if item['id'] == sample_id:
                item['status'] = 'reviewed'
                item['analyst_label'] = label
                item['analyst_notes'] = notes
                item['review_date'] = datetime.now().isoformat()
                
                # Save for retraining
                self._save_for_retraining(item)
                break
    
    def _save_for_retraining(self, review_item: Dict):
        """Save analyst-labeled sample for future retraining"""
        filename = os.path.join(self.review_dir, "retrain_queue.jsonl")
        with open(filename, 'a') as f:
            f.write(json.dumps(review_item) + '\n')


# ============================================================================
# FINAL DECISION LOGIC
# ============================================================================

def make_final_decision(layer0_result: Dict, layer1_result: Dict) -> Dict:
    """
    Combine Layer 0 and Layer 1 results into final decision
    
    Decision Rules:
    1. If supervised says ATTACK with high confidence (>85%) → BLOCK
    2. If both layers say ATTACK → BLOCK (high confidence)
    3. If supervised says NORMAL with high confidence (>90%) → PASS (even if unsupervised flags)
    4. If supervised says NORMAL with low confidence + unsupervised flags → REVIEW
    5. If both say NORMAL → PASS
    """
    
    layer0_anomaly = layer0_result['is_anomaly']
    layer1_attack = layer1_result['is_attack']
    layer1_conf = layer1_result['confidence']
    
    # Rule 1: High-confidence supervised attack detection
    if layer1_attack and layer1_conf > 0.85:
        return {
            'final_decision': 'BLOCK',
            'threat_level': 'HIGH',
            'confidence': layer1_conf,
            'reason': 'High-confidence attack detected by supervised models',
            'attack_type': layer1_result['attack_type']
        }
    
    # Rule 2: Both layers agree on attack
    if layer0_anomaly and layer1_attack:
        return {
            'final_decision': 'BLOCK',
            'threat_level': 'CRITICAL',
            'confidence': min(layer1_conf * 1.1, 1.0),  # Boost confidence
            'reason': 'Both unsupervised and supervised layers detected attack',
            'attack_type': layer1_result['attack_type']
        }
    
    # Rule 3: High-confidence supervised says normal (override unsupervised)
    if not layer1_attack and layer1_conf > 0.90:
        return {
            'final_decision': 'PASS',
            'threat_level': 'NONE',
            'confidence': layer1_conf,
            'reason': 'Supervised models highly confident traffic is normal',
            'attack_type': 'Normal Traffic'
        }
    
    # Rule 4: Conflict with low confidence → Human review
    if layer0_anomaly and not layer1_attack and layer1_conf < 0.90:
        return {
            'final_decision': 'REVIEW',
            'threat_level': 'MEDIUM',
            'confidence': 0.5,
            'reason': 'Unsupervised flagged anomaly but supervised uncertain',
            'attack_type': 'Unknown'
        }
    
    # Rule 5: Both say normal
    return {
        'final_decision': 'PASS',
        'threat_level': 'NONE',
        'confidence': layer1_conf,
        'reason': 'Both layers indicate normal traffic',
        'attack_type': 'Normal Traffic'
    }


