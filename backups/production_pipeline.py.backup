    ║     3-Layer Defense System                                ║
    ╚═══════════════════════════════════════════════════════════╝
    """)
    
    # Initialize
    pipeline = ProductionPipeline()
    pipeline.load_models()
    
    print("\n✅ Pipeline initialized successfully!")
    print("\nUse pipeline.analyze() to process network traffic")