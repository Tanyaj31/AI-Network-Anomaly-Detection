class ProductionPipeline:
    """
    Complete 3-Layer Network IDS Pipeline
    
    Usage:
        pipeline = ProductionPipeline()
        pipeline.load_models()
        result = pipeline.analyze(cicids_feat, iot_feat, unsw_feat, raw_feat)
    """
    
    def __init__(self):
        self.loader = None
        self.layer0 = None
        self.layer1 = None
        self.layer2 = None
        self.stats = {
            'total_analyzed': 0,
            'blocked': 0,
            'passed': 0,
            'under_review': 0,
            'layer0_flagged': 0,
            'layer1_attacks': 0
        }
        
    def load_models(self):
        """Load all models"""
        print("=" * 70)
        print("🚀 INITIALIZING PRODUCTION PIPELINE")
        print("=" * 70)
        
        # Load models
        self.loader = ModelLoader()
        self.loader.load_all()
        
        # Initialize layers
        self.layer0 = Layer0_UnsupervisedFilter(self.loader)
        self.layer1 = Layer1_SupervisedClassifiers(self.loader)
        self.layer2 = Layer2_HumanReview()
        
        print("\n✅ Production pipeline ready!")
        print("   ⚡ PARALLEL ARCHITECTURE: Both layers run on ALL traffic")
        print("   • Layer 0: 2 Autoencoders (CICIDS + UNSW)")
        print("   • Layer 1: 3 XGBoost Specialists (CICIDS + IoT + UNSW)")
        print("   • Layer 2: Human Review System")
        print("   • No blind spots - catches obvious AND stealthy attacks!")
        print("=" * 70)
        
    
    def analyze(self, cicids_features: np.ndarray, iot_features: np.ndarray,
                unsw_features: np.ndarray, raw_features: Dict = None) -> Dict:
        """
        Analyze network traffic through 3-layer system
        ... existing analyze() code ...
        """
        # ... existing code stays the same ...
        return {
            'timestamp': datetime.now().isoformat(),
            'layer0_unsupervised': layer0_result,
            'layer1_supervised': layer1_result,
            'final_decision': final_decision,
            'needs_human_review': needs_review
        }
    
    # ═══════════════════════════════════════════════════════════
    # 🚀 ADD THIS NEW METHOD HERE (RIGHT AFTER analyze())
    # ═══════════════════════════════════════════════════════════
    
    def analyze_batch(self, cicids_batch: np.ndarray, iot_batch: np.ndarray, 
                      unsw_batch: np.ndarray) -> List[Dict]:
        """
        ⚡ BATCH PROCESSING: Analyze multiple flows at once (200x faster!)
        
        Args:
            cicids_batch: numpy array (N, 52) - N flows with CICIDS features
            iot_batch: numpy array (N, 39) - N flows with IoT features
            unsw_batch: numpy array (N, 48) - N flows with UNSW features
            
        Returns:
            List of N result dictionaries (same format as analyze())
        """
        batch_size = len(cicids_batch)
        results = []
        
        # ═══════════════════════════════════════════════════════════
        # LAYER 0: UNSUPERVISED ANOMALY DETECTION (BATCH)
        # ═══════════════════════════════════════════════════════════
        
        # Scale all features at once
        cicids_scaled = self.layer0.scalers['cicids'].transform(cicids_batch)
        unsw_scaled = self.layer0.scalers['unsw'].transform(unsw_batch)
        
        # CICIDS Autoencoder - batch prediction
        cicids_recon = self.layer0.models['cicids'].predict(cicids_scaled, verbose=0)
        cicids_errors = np.mean(np.abs(cicids_scaled - cicids_recon), axis=1)
        cicids_anomalies = cicids_errors > self.layer0.thresholds['cicids']
        
        # UNSW Autoencoder - batch prediction
        unsw_recon = self.layer0.models['unsw'].predict(unsw_scaled, verbose=0)
        unsw_errors = np.mean(np.abs(unsw_scaled - unsw_recon), axis=1)
        unsw_anomalies = unsw_errors > self.layer0.thresholds['unsw']
        
        # Combined Layer 0 decision
        layer0_anomaly_flags = cicids_anomalies | unsw_anomalies
        
        # ═══════════════════════════════════════════════════════════
        # LAYER 1: SUPERVISED CLASSIFICATION (BATCH)
        # ═══════════════════════════════════════════════════════════
        
        # Scale IoT features
        iot_scaled = self.layer1.scalers['iot'].transform(iot_batch)
        
        # Get predictions from all 3 specialists (batch mode)
        cicids_preds = self.layer1.models['cicids'].predict(cicids_scaled)
        cicids_probas = self.layer1.models['cicids'].predict_proba(cicids_scaled)
        
        iot_preds = self.layer1.models['iot'].predict(iot_scaled)
        iot_probas = self.layer1.models['iot'].predict_proba(iot_scaled)
        
        unsw_preds = self.layer1.models['unsw'].predict(unsw_scaled)
        unsw_probas = self.layer1.models['unsw'].predict_proba(unsw_scaled)
        
        # ═══════════════════════════════════════════════════════════
        # ENSEMBLE VOTING (PER FLOW)
        # ═══════════════════════════════════════════════════════════
        
        for i in range(batch_size):
            self.stats['total_analyzed'] += 1
            
            # Layer 0 results for this flow
            layer0_result = {
                'is_anomaly': bool(layer0_anomaly_flags[i]),
                'cicids_score': float(cicids_errors[i]),
                'cicids_threshold': float(self.layer0.thresholds['cicids']),
                'cicids_anomaly': bool(cicids_anomalies[i]),
                'unsw_score': float(unsw_errors[i]),
                'unsw_threshold': float(self.layer0.thresholds['unsw']),
                'unsw_anomaly': bool(unsw_anomalies[i]),
                'flagged_by': []
            }
            
            if cicids_anomalies[i]:
                layer0_result['flagged_by'].append('CICIDS_Autoencoder')
            if unsw_anomalies[i]:
                layer0_result['flagged_by'].append('UNSW_Autoencoder')
            
            layer0_result['flagged_count'] = len(layer0_result['flagged_by'])
            
            if layer0_result['is_anomaly']:
                self.stats['layer0_flagged'] += 1
            
            # Layer 1 results for this flow
            cicids_label = self.layer1.encoders['cicids'].inverse_transform([cicids_preds[i]])[0]
            iot_label = self.layer1.encoders['iot'].inverse_transform([iot_preds[i]])[0]
            unsw_label = self.layer1.encoders['unsw'].inverse_transform([unsw_preds[i]])[0]
            
            cicids_conf = float(np.max(cicids_probas[i]))
            iot_conf = float(np.max(iot_probas[i]))
            unsw_conf = float(np.max(unsw_probas[i]))
            
            # Check if predictions are attacks
            cicids_is_attack = cicids_label.lower() not in ['normal', 'normal traffic', 'benign']
            iot_is_attack = iot_label.lower() not in ['normal', 'normal traffic', 'benign']
            unsw_is_attack = unsw_label.lower() not in ['normal', 'normal traffic', 'benign']
            
            all_predictions = [
                {
                    'specialist': 'CICIDS_XGBoost',
                    'prediction': cicids_label,
                    'confidence': cicids_conf,
                    'is_attack': cicids_is_attack
                },
                {
                    'specialist': 'IoT_XGBoost',
                    'prediction': iot_label,
                    'confidence': iot_conf,
                    'is_attack': iot_is_attack
                },
                {
                    'specialist': 'UNSW_XGBoost',
                    'prediction': unsw_label,
                    'confidence': unsw_conf,
                    'is_attack': unsw_is_attack
                }
            ]
            
            # Count attack votes
            attack_votes = sum(1 for p in all_predictions if p['is_attack'])
            
            # Ensemble decision: majority vote
            if attack_votes >= 2:
                # Majority says attack - pick highest confidence attack prediction
                attack_preds = [p for p in all_predictions if p['is_attack']]
                winner = max(attack_preds, key=lambda x: x['confidence'])
                ensemble_decision = winner['prediction']
                ensemble_conf = winner['confidence']
                is_attack = True
            else:
                # Majority says normal
                normal_preds = [p for p in all_predictions if not p['is_attack']]
                if normal_preds:
                    winner = max(normal_preds, key=lambda x: x['confidence'])
                    ensemble_decision = "Normal Traffic"
                    ensemble_conf = winner['confidence']
                else:
                    # All predict attack but < 2 votes (shouldn't happen with 3 models)
                    winner = max(all_predictions, key=lambda x: x['confidence'])
                    ensemble_decision = winner['prediction']
                    ensemble_conf = winner['confidence']
                is_attack = False
            
            layer1_result = {
                'attack_type': ensemble_decision,
                'confidence': ensemble_conf,
                'is_attack': is_attack,
                'attack_votes': attack_votes,
                'all_predictions': all_predictions
            }
            
            if is_attack:
                self.stats['layer1_attacks'] += 1
            
            # Final decision
            final_decision = make_final_decision(layer0_result, layer1_result)
            
            # Update stats
            if final_decision['final_decision'] == 'BLOCK':
                self.stats['blocked'] += 1
            elif final_decision['final_decision'] == 'PASS':
                self.stats['passed'] += 1
            elif final_decision['final_decision'] == 'REVIEW':
                self.stats['under_review'] += 1
            
            # Check if needs human review
            needs_review = self.layer2.needs_review(layer0_result, layer1_result)
            
            # Build result
            result = {
                'timestamp': datetime.now().isoformat(),
                'layer0_unsupervised': layer0_result,
                'layer1_supervised': layer1_result,
                'final_decision': final_decision,
                'needs_human_review': needs_review
            }
            
            results.append(result)
        
        return results
    

